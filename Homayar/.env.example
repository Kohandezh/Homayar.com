# Homayar backend development template.
# Never commit a populated .env file. Production values belong in the
# deployment secret manager or an operator-owned mode-0600 environment file.

# Application
ENVIRONMENT=development
DEPLOYMENT_MODE=onprem
APP_NAME=Homayar
API_PREFIX=/api/v1
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173/app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=false

# PostgreSQL and Redis. URL-encode reserved characters in credentials.
DATABASE_URL=sqlite:///./homayar-dev.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# PostgreSQL row-level security runs application SQL as the non-bypass role
# homayar_app (created by the migrations). Leave empty when DATABASE_URL already
# logs in as a member of that role; set to homayar_app when it logs in as the
# migration owner so every pooled connection switches with SET ROLE.
DATABASE_APP_ROLE=
REDIS_URL=redis://localhost:6379/0

# Authentication and session security. Generate independent random values.
JWT_SECRET=
TOKEN_PEPPER=
JWT_ISSUER=homayar
JWT_AUDIENCE=homayar-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SECURE_COOKIES=false
COOKIE_DOMAIN=
RATE_LIMIT_FAIL_OPEN=false
ENABLE_DEMO_ACCOUNT=false
ENABLE_FREE_DEMO=true
DEMO_QUOTA_SECONDS=1800

# Optional Google and phone authentication
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
ENABLE_PHONE_AUTH=false
ASANAK_BASE_URL=https://panel.asanak.com/webservice/v1rest/sendsms
ASANAK_API_KEY=
ASANAK_SENDER=

# Private recording storage and upload validation
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/objects
STORAGE_BUCKET=homayar-private
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PRESIGN_TTL_SECONDS=300
UPLOAD_DIR=./data/legacy-uploads
UPLOAD_QUARANTINE_DIR=./data/quarantine
MAX_UPLOAD_SIZE_MB=250
MAX_AUDIO_DURATION_SECONDS=14400
ALLOWED_EXTENSIONS=.wav,.mp3,.ogg,.m4a,.aac,.flac,.mp4,.webm
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=10
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SECONDS=20
# Bounded decode check of the first N seconds of every upload (0 disables)
MEDIA_DECODE_PROBE_SECONDS=30
# Compressed audio claiming fewer bytes per second than this is refused
MEDIA_MIN_BYTES_PER_SECOND=64
UPLOAD_RATE_LIMIT_PER_HOUR=30
RETENTION_DAYS_DEFAULT=90

# Jobs and providers
TASKS_EAGER=false
WORKER_CONCURRENCY_PER_WORKSPACE=2
# Execution leases (WP06-T04). A running attempt that is not renewed within
# JOB_LEASE_SECONDS is fenced and requeued by the recovery sweeper (Celery beat
# every JOB_RECOVERY_SWEEP_INTERVAL_SECONDS, or `python -m backend.jobs.recovery`).
JOB_LEASE_SECONDS=120
JOB_LEASE_RENEW_INTERVAL_SECONDS=30
JOB_STAGE_TIMEOUT_SECONDS=1800
JOB_ATTEMPT_TIMEOUT_SECONDS=7200
JOB_RECOVERY_SWEEP_INTERVAL_SECONDS=60
JOB_RECOVERY_BATCH_SIZE=100
# Retry budget and dead-letter policy (WP06-T05): JOB_MAX_ATTEMPTS execution
# attempts per replay window with exponential back-off (JOB_RETRY_DELAY_SECONDS
# doubling up to JOB_RETRY_MAX_DELAY_SECONDS), one overall JOB_DEADLINE_SECONDS
# per job and at most JOB_MAX_REPLAYS operator replays of a dead-lettered job
# (POST /api/v1/admin/jobs/{id}/replay).
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=30
JOB_RETRY_MAX_DELAY_SECONDS=600
JOB_DEADLINE_SECONDS=86400
JOB_MAX_REPLAYS=3
# Usage ledger reconciliation (WP06-T06): periodic sweep (Celery beat every
# USAGE_RECONCILIATION_INTERVAL_SECONDS, or `python -m backend.jobs.usage_reconciliation`)
# that releases reservations orphaned for longer than the grace period and
# compares entitlement counters with the reservation rows. Drift is reported
# and audited; counters are corrected only when REPAIR_COUNTERS is true.
USAGE_RECONCILIATION_INTERVAL_SECONDS=900
USAGE_RECONCILIATION_GRACE_SECONDS=600
USAGE_RECONCILIATION_BATCH_SIZE=200
USAGE_RECONCILIATION_REPAIR_COUNTERS=false
# Stage checkpoints and attempt-scoped artifacts (WP06-T03): a retry reuses a
# committed ASR/diarization/analysis result whose declared inputs (audio
# digest, provider identity and model, prompt contract, upstream artifacts)
# match and whose artifact verifies; JOB_ARTIFACT_MAX_BYTES bounds one
# artifact. Objects of never-published or invalidated checkpoints older than
# JOB_ARTIFACT_GRACE_SECONDS are removed by the cleanup sweep (Celery beat
# every JOB_ARTIFACT_SWEEP_INTERVAL_SECONDS, or
# `python -m backend.jobs.checkpoints`); published artifacts of live
# meetings are never removed by it.
JOB_CHECKPOINT_REUSE_ENABLED=true
JOB_ARTIFACT_MAX_BYTES=16777216
JOB_ARTIFACT_GRACE_SECONDS=3600
JOB_ARTIFACT_SWEEP_INTERVAL_SECONDS=900
JOB_ARTIFACT_SWEEP_BATCH_SIZE=200
# API keys (WP03-T07): workspace-owned keys bound to the creating user with a
# fixed scope set; API_KEY_RATE_LIMIT_PER_HOUR bounds requests per key,
# API_KEY_MAX_ACTIVE_PER_WORKSPACE bounds live keys per workspace and
# API_KEY_MAX_TTL_DAYS bounds the expiry an owner/admin may request.
API_KEY_RATE_LIMIT_PER_HOUR=600
API_KEY_MAX_ACTIVE_PER_WORKSPACE=20
API_KEY_MAX_TTL_DAYS=365
ALLOW_MOCK_PROVIDERS=false
ASR_PROVIDER=local_whisper
DIARIZATION_PROVIDER=unavailable
INTELLIGENCE_PROVIDER=openai_compatible
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
LOCAL_AI_BASE_URL=
LLM_PROVIDER=auto
LLM_MODEL=default
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/v1
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://gapgpt.app/api/v1

# Email
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@homayar.com
SMTP_USE_TLS=false

# Optional Neo4j projection
ENABLE_NEO4J_PROJECTION=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Observability and billing. Pricing remains manually administered.
SENTRY_DSN=
METRICS_ENABLED=true
BILLING_PROVIDER=manual
