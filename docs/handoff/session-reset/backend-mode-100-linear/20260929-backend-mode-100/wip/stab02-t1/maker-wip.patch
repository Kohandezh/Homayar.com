         _wait(lambda: _job(job_id).state == JobState.COMPLETED, what="held attempt completed")
+        # COMPLETED is committed inside the task, which still has work to do
+        # before it returns (heartbeat stop, audio deletion, voicemail hook),
+        # and ``TransportProcess.stop`` signals the workers' whole process
+        # group, pool child included.  Stopping now can kill the child before it
+        # logs the result asserted below, so wait for the task's own result line.
+        _wait(
+            lambda: "completed" in _statuses(holder, other),
+            what="held attempt returned its result",
+        )
+        # Already true once the copy was acknowledged, not evidence that the
+        # holder was: the redelivered copy carries the original delivery tag, so
+        # its acknowledgement clears that tag from Redis' unacked set.
         _wait(
             lambda: drill.redis() == {"queued": 0, "unacked": 0}, what="all deliveries acknowledged"
         )
