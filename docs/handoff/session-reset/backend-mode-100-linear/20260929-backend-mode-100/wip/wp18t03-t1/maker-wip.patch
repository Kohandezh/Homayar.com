+    plan = db.get(Plan, DEMO_PLAN_KEY)
+    if plan is None or _quota_applied(plan, _current_version(db, plan), quota):
+        return
+    plan = _lock_plan(db, DEMO_PLAN_KEY)
+    if plan is None or _quota_applied(plan, _current_version(db, plan), quota):
+        return
+    entitlements = dict(plan.entitlements_json) if isinstance(plan.entitlements_json, dict) else {}
+    entitlements["audio_seconds"] = quota
+    _append_version(
+        db,
+        plan,
+        name=plan.name,
+        is_public=plan.is_public,
+        entitlements=entitlements,
+        source="config",
+    )
+
+
+def _append_version(
+    db: Session,
+    plan: Plan,
+    *,
+    name: str,
+    is_public: bool,
+    entitlements: dict[str, Any],
+    source: str,
+) -> PlanVersion:
+    """Append ``current_version + 1`` to a plan row locked by the caller."""
+    version = PlanVersion(
+        plan_key=plan.key,
+        version=plan.current_version + 1,
+        name=name,
+        is_public=is_public,
+        entitlements_json=dict(entitlements),
+        source=source,
+    )
+    db.add(version)
+    plan.name = name
+    plan.is_public = is_public
+    plan.entitlements_json = dict(entitlements)
+    plan.current_version = version.version
+    db.flush()
+    logger.info(
+        "PLAN_VERSION_PUBLISHED plan=%s version=%d source=%s", plan.key, version.version, source
+    )
+    return version
+
+
+def _grant_demo(db: Session, *, workspace_id: str, now: datetime) -> None:
+    """The free demo: a subscription pinned to the demo plan's current version.
+
+    Entitlement rows come from that version's metered metrics.  JSON null is an
+    unlimited limit; a metric the version does not define gets no row, so its
+    use is refused (fail closed).
+    """
+    version = db.scalars(
+        select(PlanVersion)
+        .join(
+            Plan,
+            and_(Plan.key == PlanVersion.plan_key, Plan.current_version == PlanVersion.version),
+        )
