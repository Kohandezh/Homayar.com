+            .values(
+                name="Enterprise (negotiated)",
+                entitlements_json={"audio_seconds": 900000, "seats": 50},
+            )
+        )
+        db.execute(update(plans).where(plans.c.key == "on_premise").values(is_active=False))
+        db.commit()
