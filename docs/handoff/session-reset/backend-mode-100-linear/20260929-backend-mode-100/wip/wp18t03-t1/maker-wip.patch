+def test_exactly_one_new_revision_follows_the_base() -> None:
+    script = ScriptDirectory.from_config(Config(str(REPO_ROOT / "alembic.ini")))
+    heads = script.get_heads()
+    assert len(heads) == 1
+    children = [
+        revision for revision in script.walk_revisions() if revision.down_revision == BASE_REVISION
+    ]
+    assert [revision.revision for revision in children] == heads
+    head = script.get_revision(heads[0])
+    assert Path(head.path).name.endswith("_versioned_plans.py")
+    assert callable(head.module.backfill_plan_versions)
+    source = Path(head.path).read_text(encoding="utf-8")
+    assert "apply_row_level_security" in source
