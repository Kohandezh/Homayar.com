+        functools.partial(ref.speech.normalize_fa, punctuation=False),
+    ),
+    "speech.normalize_en": (prod_speech.normalize_en, ref.speech.normalize_en),
+    "speech.normalize_az": (prod_speech.normalize_az, ref.speech.normalize_az),
+    "speech.normalize_for_matching(fa)": (
+        functools.partial(prod_speech.normalize_for_matching, language="fa"),
+        functools.partial(ref.speech.normalize_for_matching, language="fa"),
+    ),
+    "speech.normalize_for_matching(en)": (
+        functools.partial(prod_speech.normalize_for_matching, language="en"),
+        functools.partial(ref.speech.normalize_for_matching, language="en"),
+    ),
+    "speech.normalize_for_matching(az)": (
+        functools.partial(prod_speech.normalize_for_matching, language="az"),
+        functools.partial(ref.speech.normalize_for_matching, language="az"),
+    ),
+    "locations.normalize_char_stream (text, offsets, original, every span)": (
+        _viewed(prod_locations.normalize_char_stream),
+        _viewed(ref.locations.normalize_char_stream),
+    ),
+    "locations.normalize_text": (prod_locations.normalize_text, ref.locations.normalize_text),
+    "locations.is_word_char": (prod_locations.is_word_char, ref.locations.is_word_char),
+    "voicemail.normalize_text": (prod_voicemail.normalize_text, ref.voicemail.normalize_text),
+    "voicemail.is_empty_transcript": (
+        prod_voicemail.is_empty_transcript,
+        ref.voicemail.is_empty_transcript,
+    ),
+    "security.normalize_iranian_mobile (value or exception)": (
+        _raising(prod_security.normalize_iranian_mobile),
+        _raising(ref.security.normalize_iranian_mobile),
+    ),
+    "voicemail.ingest.normalize_caller_number": (
+        prod_ingest.normalize_caller_number,
+        ref.ingest.normalize_caller_number,
+    ),
+}
+# One-to-one maps whose output length must equal the input length (offsets depend on it).
+LENGTH_PRESERVING: dict[str, Callable[[str], str]] = {
+    "text_pii.normalize_digits": prod_text_pii.normalize_digits,
+    "speech.unify_arabic_letters": prod_speech.unify_arabic_letters,
+}
+
+
+def _sweep_inputs(template: int, start: int, stop: int) -> list[str]:
+    _label, prefix, suffix = TEMPLATES[template]
+    return [prefix + chr(code) + suffix for code in CODE_POINTS[start:stop]]
+
+
+def _describe(text: str, produced: object, expected: object) -> str:
+    return (
+        f"input {text!r} (code points {[hex(ord(c)) for c in text]}): {produced!r} != {expected!r}"
+    )
+
+
+def _sweep_job(job: tuple[int, int, int]) -> dict[str, object]:
+    """One template x one slice of code points through every function (worker entry point)."""
+    template, start, stop = job
+    inputs = _sweep_inputs(template, start, stop)
+    checked: dict[str, int] = {}
+    mismatches: dict[str, list[str]] = {}
+    for name, (production, reference) in SWEEP.items():
+        try:
+            produced = list(map(production, inputs))
+            expected = list(map(reference, inputs))
+            fast = produced == expected
+        except Exception:  # compare input by input below, exceptions included
+            fast = False
+        if not fast:
+            produced = [_outcome(production, text) for text in inputs]
+            expected = [_outcome(reference, text) for text in inputs]
+            bad = [i for i, (p, e) in enumerate(zip(produced, expected, strict=True)) if p != e]
+            if bad:
+                mismatches[name] = [
+                    _describe(inputs[i], produced[i], expected[i]) for i in bad[:_MAX_REPORTED]
+                ] + ([f"... {len(bad)} mismatching inputs in this job"] if len(bad) > 1 else [])
+        checked[name] = len(inputs)
+    length_violations: dict[str, list[str]] = {}
+    for name, func in LENGTH_PRESERVING.items():
+        wrong = [text for text in inputs if len(func(text)) != len(text)]
+        if wrong:
+            length_violations[name] = [repr(text) for text in wrong[:_MAX_REPORTED]]
+    return {
+        "job": job,
+        "checked": checked,
+        "mismatches": mismatches,
+        "length_violations": length_violations,
+    }
+
+
+def _jobs() -> list[tuple[int, int, int]]:
+    return [
+        (template, start, min(start + _CHUNK, len(CODE_POINTS)))
+        for template in range(len(TEMPLATES))
+        for start in range(0, len(CODE_POINTS), _CHUNK)
+    ]
+
+
+def _worker_count() -> int:
+    try:
+        cpus = len(os.sched_getaffinity(0))
+    except AttributeError:  # not Linux
+        cpus = os.cpu_count() or 1
+    return max(1, min(4, cpus))
+
+
+def _single_threaded() -> bool:
+    try:
+        return len(os.listdir("/proc/self/task")) == 1
+    except OSError:
+        return threading.active_count() == 1
+
+
+@pytest.fixture(scope="module")
+def sweep() -> dict[str, object]:
+    jobs = _jobs()
+    workers = _worker_count()
+    if workers == 1:
+        results = [_sweep_job(job) for job in jobs]
+    else:
+        # fork is cheap and safe while this process has one thread; otherwise spawn.
+        context = multiprocessing.get_context("fork" if _single_threaded() else "spawn")
+        with ProcessPoolExecutor(max_workers=workers, mp_context=context) as pool:
+            results = list(pool.map(_sweep_job, jobs))
+    checked: dict[str, int] = {}
+    mismatches: dict[str, list[str]] = {}
+    length_violations: dict[str, list[str]] = {}
+    covered: dict[int, list[tuple[int, int]]] = {}
+    for result in results:
+        template, start, stop = result["job"]
+        covered.setdefault(template, []).append((start, stop))
+        for name, count in result["checked"].items():
+            checked[name] = checked.get(name, 0) + count
+        for name, lines in result["mismatches"].items():
+            mismatches.setdefault(name, []).extend(f"[{TEMPLATES[template][0]}] {x}" for x in lines)
+        for name, lines in result["length_violations"].items():
+            length_violations.setdefault(name, []).extend(lines)
+    return {
+        "checked": checked,
+        "mismatches": mismatches,
+        "length_violations": length_violations,
+        "covered": covered,
+    }
+
+
+def test_sweep_covers_every_bmp_code_point_in_every_template(sweep) -> None:
+    assert len(CODE_POINTS) == 0x10000 - 0x800 and len(set(CODE_POINTS)) == len(CODE_POINTS)
+    assert CODE_POINTS[0] == 0 and CODE_POINTS[-1] == 0xFFFF
+    assert not any(0xD800 <= code <= 0xDFFF for code in CODE_POINTS)
+    assert sorted(sweep["covered"]) == list(range(len(TEMPLATES)))
+    for ranges in sweep["covered"].values():
+        edges = sorted(ranges)
+        assert edges[0][0] == 0 and edges[-1][1] == len(CODE_POINTS)
+        assert all(left[1] == right[0] for left, right in zip(edges, edges[1:], strict=False))
+
+
+@pytest.mark.parametrize("name", list(SWEEP))
+def test_sweep_output_equals_the_frozen_base_copy(sweep, name: str) -> None:
+    assert sweep["checked"][name] == len(CODE_POINTS) * len(TEMPLATES)
+    assert sweep["mismatches"].get(name, []) == []
+
+
+@pytest.mark.parametrize("name", list(LENGTH_PRESERVING))
+def test_sweep_one_to_one_maps_keep_the_length(sweep, name: str) -> None:
+    assert sweep["length_violations"].get(name, []) == []
+
