+"""WP22-T02 (HOM-120) golden no-behaviour-change tests for Persian/Arabic text normalisation.
+
+Provenance: captured at base ``7112407`` (BASE_SHA of team wp22t02-t1) from the copies in
+``backend/speech/text_normalize.py``, ``backend/locations/textnorm.py``,
+``backend/voicemail/classify.py``, ``backend/privacy/text_pii.py`` and
+``backend/security/normalization.py`` (plus the granted sites ``backend/voicemail/ingest.py``
+:99-101 and ``backend/routers/v1/auth.py``:616-618).  The frozen reference copies, with their
+file:line ranges, live in ``backend/tests/_text_normalization_reference.py``.
+
+Two kinds of evidence, both pure functions (no database, no client):
+
+- An exhaustive differential sweep: every BMP code point except the surrogates, in eight
+  templates, through every normaliser, compared with the frozen BASE_SHA copies (not with
+  literals, so the sweep holds whatever Unicode version Python ships).  The sweep is split into
+  jobs that run in worker processes when the machine has more than one CPU.
+- A literal golden corpus: detector, redaction, voicemail classification/prioritisation and
+  location extraction outputs, written as literals captured at base.  Literal inputs use only
+  code points whose Unicode properties are the same in Unicode 15.0 and 15.1.
+
+This module imports only names that exist at BASE_SHA, so it passes unmodified on a clean
+base checkout (Foreman gate G-base) and on the migrated head.
+"""
+
+# ruff: noqa: E501 - the literal corpus below keeps one captured case per line
+
+from __future__ import annotations
+
+import functools
+import multiprocessing
+import os
+import threading
+from collections.abc import Callable
+from concurrent.futures import ProcessPoolExecutor
+
+import pytest
+
+from backend.locations import textnorm as prod_locations
+from backend.locations.extract import extract_locations
+from backend.privacy import text_pii as prod_text_pii
+from backend.privacy.redaction_service import policy_digest
+from backend.security import normalization as prod_security
+from backend.speech import text_normalize as prod_speech
+from backend.tests import _text_normalization_reference as ref
+from backend.voicemail import classify as prod_voicemail
+from backend.voicemail import ingest as prod_ingest
+
+# --- exhaustive differential sweep --------------------------------------------------
+
+CODE_POINTS: tuple[int, ...] = tuple(c for c in range(0x10000) if not 0xD800 <= c <= 0xDFFF)
+
+# (label, prefix, suffix): the sweep string is prefix + chr(code point) + suffix.
+TEMPLATES: tuple[tuple[str, str, str], ...] = (
+    ("c", "", ""),
+    ("beh c beh", "ب", "ب"),
+    ("fa-one c 2", "۱", "2"),
+    ("arabic-yeh c", "\u064a", ""),
+    ("c hamza-above", "", "\u0654"),
+    ("c maddah-above", "", "\u0653"),
+    ("mi-space c ravam", "می ", "روم"),
+    ("ketab-space c ha", "کتاب ", "ها"),
+)
+
+_CHUNK = 7936  # code points per job: 8 jobs per template, 64 jobs in all
+_MAX_REPORTED = 5  # mismatching inputs reported per function and job
+
+
+def _outcome(func: Callable[[str], object], text: str) -> tuple[str, object]:
+    """A value or the exception it raised, so raising functions compare like values."""
+    try:
+        return ("value", func(text))
+    except Exception as exc:  # the exception type and message are the result
+        return ("raises", f"{type(exc).__name__}: {exc}")
+
+
+def _stream_view(result) -> tuple[object, ...]:
+    """``normalize_char_stream`` result plus ``span(i, j)`` for every 0 <= i <= j <= len."""
+    size = len(result.text)
+    span = result.span
+    spans = [span(i, j) for i in range(size + 1) for j in range(i, size + 1)]
+    return (result.text, result.offsets, result.original, spans)
+
+
+def _raising(func: Callable[[str], object]) -> Callable[[str], object]:
+    return functools.partial(_outcome, func)
+
+
+def _viewed(func: Callable[[str], object]) -> Callable[[str], object]:
+    def call(text: str) -> object:
+        return _stream_view(func(text))
+
+    return call
+
+
+# name -> (production, frozen base reference).  Production names all exist at BASE_SHA.
+SWEEP: dict[str, tuple[Callable[[str], object], Callable[[str], object]]] = {
+    "text_pii.normalize_digits": (prod_text_pii.normalize_digits, ref.text_pii.normalize_digits),
+    "auth OTP code digits (routers/v1/auth.py:616-618)": (
+        prod_text_pii.normalize_digits,
+        ref.otp_code_digits,
+    ),
+    "speech.unify_arabic_letters": (
