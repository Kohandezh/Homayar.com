+def test_spec_detector_probes() -> None:
+    """The detector values the SPEC lists under its divergence table, spelled out."""
+    detect = prod_text_pii.detect
+    phone = "شماره من ۰۹۱۲ ۳۴۵ ۶۷۸۹ است"
+    assert [(s.start, s.end, s.pii_class.value, s.value) for s in detect(phone)] == [
+        (9, 22, "phone", "09123456789")
+    ]
+    redacted, replacements = prod_text_pii.redact(phone)
+    assert redacted == "شماره من [PHONE_1] است"
+    assert [r.value for r in replacements] == ["۰۹۱۲ ۳۴۵ ۶۷۸۹"]
+    postal = detect("کد پستی ۱۴۳۵۶۷۸۹۱۲ است")
+    assert [(s.start, s.end, s.pii_class.value, s.value) for s in postal] == [
+        (8, 18, "ir_postal_code", "1435678912")
+    ]
+    assert detect("\u0643د پست\u064a ۱۴۳۵۶۷۸۹۱۲ است") == []  # Arabic kaf and yeh
+    assert detect("کد\u200cپستی ۱۴۳۵۶۷۸۹۱۲ است") == []
+    assert detect("موبایل \uff10\uff19\uff11\uff12\uff13\uff14\uff15\uff16\uff17\uff18\uff19") == []
+    fullwidth_id = "\uff11\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff11"
+    spans = detect("کد " + fullwidth_id + " تمام")
+    assert [(s.start, s.end, s.pii_class.value, s.value) for s in spans] == [
+        (3, 13, "ir_national_id", fullwidth_id)
+    ]
