+def test_pii_detect_and_redact_literals(text: str, spans, redaction) -> None:
+    found = prod_text_pii.detect(text)
+    assert [(s.start, s.end, s.pii_class.value, s.value) for s in found] == spans
+    redacted, replacements = prod_text_pii.redact(text)
+    got = [(r.start, r.end, r.pii_class.value, r.placeholder, r.value) for r in replacements]
+    assert (redacted, got) == redaction
+    assert all(text[r.start : r.end] == r.value for r in replacements)  # original offsets
