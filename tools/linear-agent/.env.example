# linear-agent settings.
# Copy this file to .env in the same folder and fill in the keys.
# .env is git-ignored. Never commit it, and never put keys in any other file.

# Anthropic API key for the Claude Agent SDK.
# Create it in a separate Console workspace (for example "linear-agent")
# that has a monthly spend limit. Use an API key only, never the claude.ai login.
ANTHROPIC_API_KEY=

# Linear personal API key (Linear > Settings > Security & access > Personal API keys).
# A dry run needs only this key.
LINEAR_API_KEY=

# GitHub fine-grained token for the gh CLI.
# Repository access: Kohandezh/Homayar.com only.
# Permissions: Contents read and write, Pull requests read and write. Nothing else.
GITHUB_TOKEN=

# Optional settings. The values below are the defaults.
# LINEAR_AGENT_TEAM_KEY=HOM
# LINEAR_AGENT_TODO_STATE=Todo
# LINEAR_AGENT_IN_PROGRESS_STATE=In Progress
# LINEAR_AGENT_IN_REVIEW_STATE=In Review
# LINEAR_AGENT_DONE_STATE=Done
# LINEAR_AGENT_TRIGGER_LABEL=agent
# LINEAR_AGENT_FAILED_LABEL=agent-failed
# Tickets claimed per poll. They run one after the other, never at the same time.
# LINEAR_AGENT_MAX_CONCURRENT=1
# LINEAR_AGENT_MODEL=claude-opus-5
# LINEAR_AGENT_MAX_TURNS=80
# Spend cap per ticket in USD, for all agent runs of that ticket together.
# LINEAR_AGENT_MAX_BUDGET_USD=5
# LINEAR_AGENT_POLL_MINUTES=10
# Main checkout of the repository. Default: two folders up from tools/linear-agent.
# LINEAR_AGENT_REPO_PATH=
# LINEAR_AGENT_WORKTREE_ROOT=~/linear-agent-worktrees
# LINEAR_AGENT_BASE_REF=origin/main
# LINEAR_AGENT_BASE_BRANCH=main
# Tracked PRs and lock files. Default: <worktree root>/.linear-agent
# LINEAR_AGENT_STATE_DIR=
# UNSAFE. 1 runs the checks without a sandbox: agent-written code then runs with your rights and
# open network. Leave it unset. Use it only on a throwaway machine where the sandbox cannot start.
# LINEAR_AGENT_UNSANDBOXED_CHECKS=
