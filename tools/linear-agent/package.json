{
  "name": "linear-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Worker that picks Linear tickets labeled agent, runs the Claude Agent SDK in a fresh worktree and opens a draft PR.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "once": "tsx src/cli.ts once",
    "daemon": "tsx src/cli.ts daemon",
    "dry-run": "tsx src/cli.ts dry-run",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sandbox-runtime": "0.0.79"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
