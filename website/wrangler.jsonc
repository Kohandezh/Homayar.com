{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homayar-website",
  // worker.ts answers www.homayar.com with a 301, then hands every other request to the
  // OpenNext worker (.open-next/worker.js).
  "main": "worker.ts",
  // The newest date the pinned workerd (1.20261012.1) supports.
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The worker must see asset requests too, so www.homayar.com/_next/static/* also gets the 301.
    // OpenNext then serves the asset through the ASSETS binding.
    "run_worker_first": true
  },
  // No public *.workers.dev or preview URL. The site is only served on the custom domains.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "homayar.com", "custom_domain": true },
    { "pattern": "www.homayar.com", "custom_domain": true }
  ]
}
