{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homayar-website",
  // worker.ts answers www.homayar.com with a 301, then hands every other request to the
  // OpenNext worker (.open-next/worker.js).
  "main": "worker.ts",
  // The newest date the pinned workerd (1.20261012.1) supports.
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The worker must see asset requests too, so www.homayar.com/_next/static/* also gets the 301.
    // OpenNext then serves the asset through the ASSETS binding.
    "run_worker_first": true
  },
  // No public *.workers.dev or preview URL. The site is only served on the custom domains.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "homayar.com", "custom_domain": true },
    { "pattern": "www.homayar.com", "custom_domain": true }
  ],
  // Contact requests (lib/contact). A copy of every request is stored here before the
  // e-mail is sent. No database_id: on the first deploy wrangler connects to the database
  // with this name, or creates it (automatic provisioning). The table is created by code.
  "d1_databases": [{ "binding": "CONTACT_DB", "database_name": "homayar-website-contact" }],
  // Cloudflare Email Service. Sends the request to the owner (secret CONTACT_TO).
  // In local dev the mail is only logged, never sent.
  "send_email": [{ "name": "CONTACT_EMAIL", "allowed_sender_addresses": ["website@homayar.com"] }],
  "vars": {
    "CONTACT_FROM": "website@homayar.com"
  },
  // Every 10 minutes worker.ts `scheduled` sends failed contact requests again and
  // deletes requests older than 180 days.
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
  // Secrets (never in this file): TURNSTILE_SECRET_KEY, CONTACT_TO, and the optional
  // CONTACT_ALERT_WEBHOOK_URL. See DEPLOY.md. Local values go in .dev.vars.
}
